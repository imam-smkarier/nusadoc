# MySQL / Prisma — salin file ini menjadi .env untuk development lokal.
# Jangan commit nilai produksi atau kredensial asli.
DATABASE_URL="mysql://USER:PASSWORD@127.0.0.1:3306/nusadoc_dev"

# Midtrans Payment Gateway (PT. SMKarier Inovasi Digital)
MIDTRANS_SERVER_KEY="SB-Mid-server-xxxx"
MIDTRANS_CLIENT_KEY="SB-Mid-client-xxxx"
MIDTRANS_IS_PRODUCTION="false"
NEXT_PUBLIC_MIDTRANS_CLIENT_KEY="SB-Mid-client-xxxx"

# Kunci enkripsi kredensial delivery email/WA (64 hex chars = 32 byte)
# Buat dengan: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
DELIVERY_ENC_KEY=""
